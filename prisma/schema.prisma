generator client {
  provider = "prisma-client-js"
  previewFeatures = ["deno"]
  runtime = "deno"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── 1. Category ────────────────────────────────────────────────────────────

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?   @db.Text
  imageUrl    String?   @map("image_url") @db.VarChar(300)
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order") @db.SmallInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  products Product[]

  @@index([slug])
  @@index([sortOrder])
  @@map("categories")
}

// ─── 2. Product ─────────────────────────────────────────────────────────────

model Product {
  id             Int       @id @default(autoincrement())
  categoryId     Int       @map("category_id")
  name           String    @db.VarChar(200)
  slug           String    @unique @db.VarChar(220)
  material       String?   @db.VarChar(100)
  shortDesc      String?   @map("short_desc") @db.VarChar(300)
  description    String?   @db.Text
  imageUrl       String?   @map("image_url") @db.VarChar(300)
  isCustomizable Boolean   @default(false) @map("is_customizable")
  isFeatured     Boolean   @default(false) @map("is_featured")
  isActive       Boolean   @default(true) @map("is_active")
  viewCount      Int       @default(0) @map("view_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  category Category       @relation(fields: [categoryId], references: [id])
  sizes    ProductSize[]
  images   ProductImage[]
  enquiries Enquiry[]

  @@index([categoryId])
  @@index([slug])
  @@index([isFeatured])
  @@index([isActive])
  @@map("products")
}

// ─── 3. ProductSize ─────────────────────────────────────────────────────────

model ProductSize {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  label     String   @db.VarChar(50)
  priceMin  Decimal? @map("price_min") @db.Decimal(10, 2)
  priceMax  Decimal? @map("price_max") @db.Decimal(10, 2)
  moq       Int      @default(1) @db.SmallInt
  inStock   Boolean  @default(true) @map("in_stock")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_sizes")
}

// ─── 4. ProductImage ────────────────────────────────────────────────────────

model ProductImage {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")
  url       String @db.VarChar(300)
  altText   String? @map("alt_text") @db.VarChar(200)
  sortOrder Int    @default(0) @map("sort_order") @db.SmallInt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ─── 5. Enquiry ─────────────────────────────────────────────────────────────

enum EnquiryStatus {
  new
  in_progress
  resolved
  spam
}

model Enquiry {
  id           Int           @id @default(autoincrement())
  productId    Int?          @map("product_id")
  customerName String        @map("customer_name") @db.VarChar(150)
  organization String?       @db.VarChar(200)
  email        String        @db.VarChar(200)
  phone        String        @db.VarChar(20)
  message      String?       @db.Text
  quantity     Int?
  status       EnquiryStatus @default(new)
  notes        String?       @db.Text
  submittedAt  DateTime      @default(now()) @map("submitted_at") @db.Timestamptz()
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  product Product? @relation(fields: [productId], references: [id])

  @@index([status])
  @@index([submittedAt])
  @@map("enquiries")
}

// ─── 6. Testimonial ─────────────────────────────────────────────────────────

model Testimonial {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  designation String?  @db.VarChar(200)
  organization String? @db.VarChar(200)
  quote       String   @db.Text
  rating      Int      @default(5) @db.SmallInt
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([isActive])
  @@index([sortOrder])
  @@map("testimonials")
}

// ─── 8. Admin ───────────────────────────────────────────────────────────────

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(200)
  password  String   @db.VarChar(255)
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  sessions Session[]

  @@map("admins")
}

// ─── 9. Session ─────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(uuid())
  adminId   Int      @map("admin_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("sessions")
}
