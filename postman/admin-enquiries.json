{
  "info": {
    "name": "Delta - Admin Enquiries",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Submit Public Enquiry",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"customerName\":\"Postman Test\",\"email\":\"postman@test.com\",\"phone\":\"9876543210\",\"message\":\"Test enquiry for admin testing\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/trpc/enquiry.submit",
          "host": ["{{baseUrl}}"],
          "path": ["trpc", "enquiry.submit"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function() { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set('testEnquiryId', jsonData.result.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@deltaindustries.in\",\"password\":\"admin123\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/trpc/admin.login",
          "host": ["{{baseUrl}}"],
          "path": ["trpc", "admin.login"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('Status is 200', function() { pm.response.to.have.status(200); });"]
          }
        }
      ]
    },
    {
      "name": "List Enquiries",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/trpc/enquiry.list?input=%7B%22limit%22%3A5%2C%22offset%22%3A0%7D",
          "host": ["{{baseUrl}}"],
          "path": ["trpc", "enquiry.list"],
          "query": [
            {
              "key": "input",
              "value": "{\"limit\":5,\"offset\":0}"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('Status is 200', function() { pm.response.to.have.status(200); });"]
          }
        }
      ]
    },
    {
      "name": "Get Enquiry Stats",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/trpc/enquiry.stats",
          "host": ["{{baseUrl}}"],
          "path": ["trpc", "enquiry.stats"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('Status is 200', function() { pm.response.to.have.status(200); });"]
          }
        }
      ]
    },
    {
      "name": "Update Enquiry Status",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"id\":{{testEnquiryId}},\"status\":\"in_progress\",\"notes\":\"Updated from Postman\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/trpc/enquiry.updateStatus",
          "host": ["{{baseUrl}}"],
          "path": ["trpc", "enquiry.updateStatus"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('Status is 200', function() { pm.response.to.have.status(200); });"]
          }
        }
      ]
    }
  ]
}
